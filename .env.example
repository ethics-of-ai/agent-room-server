# AgentRoom local backend configuration
#
# Copy this file to `.env` on the Mac that runs the backend. Never commit `.env`
# or real credentials.
#
# Most blank values below are managed settings. The Mac app normally stores
# them in `$AGENTROOM_HOME/config/settings.json`. A value set here takes
# precedence, locks the setting against API edits, and applies after restart.
# Leave a managed assignment blank unless you intend to lock it.
#
# Startup values and secrets remain environment-only. They never enter the
# managed settings file or `GET /api/config`. See
# `docs/safety/TRUST_AND_SAFETY.md` for the complete trust model.

# Backend process and storage
HOST=0.0.0.0
PORT=8787
WORKSPACE_ROOT=.agentroom/workspaces
STATE_DIR=.agentroom/state

# Optional directory for operator-managed editor language assets. Defaults to
# `$AGENTROOM_HOME/catalog-assets`, then `.agentroom/catalog-assets`. The backend
# falls back to its bundled catalog when this directory has no manifest.
EDITOR_CATALOG_DIR=

# Bearer token for protected AgentRoom routes. Configure this before exposing
# the backend to another device.
AUTH_TOKEN=

# Default registered runner id. Built-ins are `codex`, `claude_code`, and
# `deepseek`. A configured ACP adapter may also be used. Defaults to `codex`.
RUNNER_KIND=

# Codex
# An executable is required before Codex turns can run.
CODEX_EXECUTABLE=
CODEX_ARGS=

# Clients can override these values per session or turn using values returned by
# `/api/coding-agent/capabilities`.
CODEX_MODEL=
# `none`, `minimal`, `low`, `medium`, `high`, or `xhigh`.
CODEX_REASONING_EFFORT=
# `standard` or `fast`.
CODEX_SERVICE_TIER=
# `jsonrpc` by default. Set `exec` only for compatibility.
CODEX_RUNNER_PROTOCOL=

# Codex trust policy. Network access is pinned explicitly at thread start, so a
# workspace `.codex/config.toml` cannot turn it back on. Codex still loads the
# registered workspace's `AGENTS.md`, skills, project config, MCP servers, and
# hooks. Register only workspaces you trust.
CODEX_APPROVAL_POLICY=
CODEX_SANDBOX_MODE=
CODEX_WORKSPACE_NETWORK_ACCESS=

# Claude Code
# The CLI path is optional. Without it, the Agent SDK resolves its bundled CLI.
CLAUDE_CODE_EXECUTABLE=
CLAUDE_CODE_MODEL=
# `low`, `medium`, `high`, or `xhigh`.
CLAUDE_CODE_REASONING_EFFORT=

# `default`, `acceptEdits`, `dontAsk`, or `bypassPermissions`. The default is
# `bypassPermissions`, which is not confined to the registered workspace.
CLAUDE_CODE_PERMISSION_MODE=

# AgentRoom normally removes explicit Anthropic credentials so turns use the
# Mac user's `claude login`. Set true to pass provider credentials through.
CLAUDE_CODE_INHERIT_PROVIDER_AUTH=

# True by default. Loads the workspace's Claude project source, including
# `CLAUDE.md`, skills, settings, hooks, MCP servers, permissions, and environment
# helpers. Stricter permission modes force isolation. Set false for no on-disk
# Claude project settings.
CLAUDE_CODE_LOAD_WORKSPACE_SKILLS=

# DeepSeek Harness
# Read `docs/engineering/DEEPSEEK_HARNESS_RUNNER.md` before setup.
#
# This must point to the JSON-RPC SDK runtime, not the `dsh` profile launcher.
# For a source checkout, use an absolute Node.js path here and put the built
# JSON-RPC entrypoint in `DEEPSEEK_ARGS`.
# Example: DEEPSEEK_EXECUTABLE=/opt/homebrew/bin/node
DEEPSEEK_EXECUTABLE=

# Absolute path to the Cordis composition. The runtime requires one. The plugin
# graph decides which tools exist and what bounds them, so inspect this file
# before use. AgentRoom cannot infer or enforce the graph's filesystem policy.
# Example: DEEPSEEK_CORDIS_CONFIG=/Users/you/.dsh/agentroom/cordis.yml
DEEPSEEK_CORDIS_CONFIG=

# Fixed comma-separated arguments. There is no shell. For a source checkout,
# put the built JSON-RPC entrypoint here. Paths cannot contain commas.
# Example: DEEPSEEK_ARGS=/Users/you/src/deepseek-harness/packages/examples/jsonrpc-demo/lib/bin.js
DEEPSEEK_ARGS=

# Model and provider are fixed when the SDK session starts. Create a new
# AgentRoom session after changing them.
DEEPSEEK_MODEL=
DEEPSEEK_PROVIDER=
# Optional positive output-token cap.
DEEPSEEK_MAX_TOKENS=

# The composition defines the accepted permission-mode vocabulary. This setting
# cannot make an unsafe plugin graph workspace-bounded.
DEEPSEEK_PERMISSION_MODE=

# Provider credential read by the composition's LLM plugin. The Mac app stores
# it in Keychain and injects it at launch. Direct backend runs may set it here.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# Live artifacts
# Enabled by default. Parses bounded SVG or Mermaid artifact regions from agent
# output and publishes `coding_artifact_*` events.
ARTIFACTS_ENABLED=

# Editor language catalog
# Enabled by default. Serves bounded TextMate grammar, theme, configuration, and
# WASM data. Clients verify SHA-256 hashes and fall back to bundled assets.
LANGUAGE_CATALOG_ENABLED=

# Spatial scene engine
# Enabled by default. Composes workspace scene or diagram documents with their
# sibling human override files. False removes the routes but does not alter the
# workspace files.
SCENE_ENGINE_ENABLED=

# Clarifying questions
# Enabled by default. Lets a coding agent pause its turn to ask the person
# driving the session a few multiple-choice questions (Claude Code's
# AskUserQuestion, Codex's request_user_input, or DeepSeek's bounded prompt
# contract) and continue with the answers.
# Answering authorizes nothing; false hides the channel from every runner.
CLARIFYING_QUESTIONS_ENABLED=

# Interactive terminal
# Off by default. Enables a real, unsandboxed shell in registered workspaces.
# The terminal inherits the Mac user's filesystem access. Shell I/O is not
# logged. Configure `AUTH_TOKEN` before enabling this on a reachable backend.
TERMINAL_ENABLED=
# Global concurrent session cap. Integer from 1 through 64. Defaults to 8.
TERMINAL_MAX_SESSIONS=
# Optional shell. Defaults to `$SHELL`, then `/bin/zsh`. Environment-only.
TERMINAL_SHELL=

# Remote trust administration
# Off by default. Allows a bearer-token client to change terminal and runner
# trust settings through `PATCH /api/config`. Keep this environment-only so a
# client cannot grant the permission through the settings file it would unlock.
REMOTE_SETTINGS_ADMIN=

# External ACP agents
# Off by default. Enables operator-defined Agent Client Protocol v1 adapters.
# Each adapter runs an admitted local executable and receives only its allowlisted
# environment. See the ACP entry in `docs/safety/TRUST_AND_SAFETY.md`.
ACP_ADAPTERS_ENABLED=

# JSON array of adapter definitions. `id` must match
# `acp_[a-z][a-z0-9_]*`. `command` must be an absolute, executable, regular file
# and cannot be a symlink. `args` are fixed. `envGrants` cannot include
# `AUTH_TOKEN`. A malformed list is ignored as a whole.
# ACP_ADAPTERS=[{"id":"acp_gemini","displayName":"Gemini CLI","command":"/opt/homebrew/bin/gemini-acp","args":["--acp"],"envGrants":["GEMINI_API_KEY"]}]
ACP_ADAPTERS=

# Per-adapter permission policy uses the adapter id in its environment name.
# Example: `ACP_GEMINI_PERMISSION_POLICY` for `acp_gemini`. Accepted values are
# `reject`, which is the default, `ask`, and `auto_allow`. The `ask` policy waits
# up to 5 minutes for a client response before rejecting the request.

# Git operations
GIT_COMMAND_TIMEOUT_MS=
# Separate timeout for fetch, pull, and push. These commands are always
# non-interactive, so a credential prompt fails instead of hanging.
GIT_NETWORK_TIMEOUT_MS=
