      {"place": "block.cube", "id": "negative", "at": [-1, 0]}
    ],
    "expect": {"refused": "invalid_request"}
  },
  {
    "name": "a place at a negative row fails validation",
    "pieces": [],
    "edits": [
      {"place": "block.cube", "id": "negative", "at": [0, -1]}
    ],
    "expect": {"refused": "invalid_request"}
  },
  {
    "name": "a move drops the pieces above its old place",
    "pieces": [
      {"id": "bottom", "kind": "piece", "catalogId": "block.cube", "cell": [0, 0], "level": 0, "rotation": 0},
      {"id": "middle", "kind": "piece", "catalogId": "block.cylinder", "cell": [0, 0], "level": 1, "rotation": 0},
      {"id": "top", "kind": "piece", "catalogId": "block.ramp", "cell": [0, 0], "level": 2, "rotation": 0},
      {"id": "base", "kind": "piece", "catalogId": "block.cube", "cell": [3, 0], "level": 0, "rotation": 0}
    ],
    "edits": [
      {"move": "middle", "to": [3, 0]}
    ],
    "expect": {"pieces": {"bottom": [0, 0, 0], "middle": [3, 0, 1], "top": [0, 0, 1], "base": [3, 0, 0]}}
  },
  {
    "name": "a move onto a road is refused",
    "pieces": [
      {"id": "cube", "kind": "piece", "catalogId": "block.cube", "cell": [0, 0], "level": 0, "rotation": 0},
      {"id": "road", "kind": "piece", "catalogId": "block.road", "cell": [0, 1], "level": 0, "rotation": 0}
    ],
    "edits": [
      {"move": "cube", "to": [0, 1]}
    ],
    "expect": {"refused": "piece_blocked"}
  },
  {
    "name": "a move onto its own column changes nothing",
    "pieces": [
      {"id": "a", "kind": "piece", "catalogId": "block.cube", "cell": [2, 2], "level": 0, "rotation": 0},
      {"id": "b", "kind": "piece", "catalogId": "block.cube", "cell": [2, 2], "level": 1, "rotation": 0}
    ],
    "edits": [
      {"move": "a", "to": [2, 2]}
    ],
    "expect": {"pieces": {"a": [2, 2, 0], "b": [2, 2, 1]}}
  },
  {
    "name": "a delete drops the pieces above it",
    "pieces": [
      {"id": "a", "kind": "piece", "catalogId": "block.cube", "cell": [0, 0], "level": 0, "rotation": 0},
      {"id": "b", "kind": "piece", "catalogId": "block.cube", "cell": [0, 0], "level": 1, "rotation": 0},
      {"id": "c", "kind": "piece", "catalogId": "block.wall", "cell": [0, 0], "level": 2, "rotation": 0}
    ],
    "edits": [
      {"delete": "a"}
    ],
    "expect": {"pieces": {"b": [0, 0, 0], "c": [0, 0, 1]}}
  },
  {
    "name": "a smaller cell size widens the board for a later place in the batch",
    "pieces": [],
    "edits": [
      {"setTable": 0.02},
      {"place": "block.cube", "id": "far", "at": [39, 39]}
    ],
    "expect": {"pieces": {"far": [39, 39, 0]}, "table": {"cellSize": 0.02, "cells": 40}}
  },
  {
    "name": "removing the table restores the default board",
    "table": {"cellSize": 0.08, "cells": 10},
    "pieces": [
      {"id": "a", "kind": "piece", "catalogId": "block.cube", "cell": [9, 9], "level": 0, "rotation": 0}
    ],
    "edits": [
      {"setTable": null},
      {"place": "block.cube", "id": "edge", "at": [15, 0]}
    ],
    "expect": {"pieces": {"a": [9, 9, 0], "edge": [15, 0, 0]}, "table": {"cellSize": 0.05, "cells": 16}}
  },
  {
    "name": "a cell size that would leave a piece off the board is refused",
    "pieces": [
      {"id": "a", "kind": "piece", "catalogId": "block.cube", "cell": [9, 2], "level": 0, "rotation": 0},
      {"id": "b", "kind": "piece", "catalogId": "block.cube", "cell": [12, 3], "level": 0, "rotation": 0}
    ],
    "edits": [
      {"setTable": 0.08}
    ],
    "expect": {"refused": "out_of_bounds"},
    "backendOnly": "The fold swaps the board without checking it, because nothing in the editor sends setTable."
  },
  {
    "name": "creating a piece with an unknown catalog id is refused",
    "pieces": [],
    "edits": [
      {"place": "block.tree", "id": "tree", "at": [0, 0]}
    ],
    "expect": {"refused": "unknown_piece"},
    "backendOnly": "The fold lands any id, because SessionSketchModel.placePiece refuses unknown ids before anything queues."
  }
]
