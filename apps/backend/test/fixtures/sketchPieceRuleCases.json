  {
    "name": "a place past the board's edge is out of bounds",
    "pieces": [],
    "edits": [
      {"place": "block.cube", "id": "off", "at": [16, 0]}
    ],
    "expect": {"refused": "out_of_bounds"}
  },
  {
    "name": "a move past the board's edge is out of bounds",
    "pieces": [
      {"id": "edge", "kind": "piece", "catalogId": "block.cube", "cell": [15, 15], "level": 0, "rotation": 0}
    ],
    "edits": [
      {"move": "edge", "to": [0, 16]}
    ],
    "expect": {"refused": "out_of_bounds"}
  },
  {
    "name": "a place at a negative column fails validation",
    "pieces": [],
