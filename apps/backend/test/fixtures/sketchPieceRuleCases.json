[
  {
    "name": "new pieces land on top of a cube and a cylinder",
    "pieces": [],
    "edits": [
      {"place": "block.cube", "id": "a", "at": [0, 0]},
      {"place": "block.cylinder", "id": "b", "at": [0, 0]},
      {"place": "block.ramp", "id": "c", "at": [0, 0]},
